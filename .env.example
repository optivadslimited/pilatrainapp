# Pilatrain app environment template.
#
# Copy to .env.local for local development:   cp .env.example .env.local
# .env.local is git-ignored. Never commit real keys.
# For builds, the same names are set as EAS environment variables, one set per
# environment (development, staging, production). See README.md.
#
# Everything prefixed EXPO_PUBLIC_ is compiled into the app and is safe to ship:
# public project URLs and publishable keys only.

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# --- Supabase (one project per environment) --- TODO(owner)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Sample video: one HLS address played for every class until the real ones are on Mux ---
# Leave empty to use the built-in public test stream. TODO(owner)
EXPO_PUBLIC_SAMPLE_VIDEO_URL=

# --- RevenueCat: public iOS SDK key --- TODO(owner)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# --- PostHog --- TODO(owner)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# --- Sentry --- TODO(owner)
EXPO_PUBLIC_SENTRY_DSN=

# --- Attribution: AppsFlyer --- TODO(owner)
# Leave either empty and the app starts no tracking and never shows Apple's
# tracking prompt. The dev key is in AppsFlyer (App settings → Dev key). The
# app ID is the app's numeric Apple ID, digits only, without "id"; it exists
# once the app is created in App Store Connect. See docs/attribution.md.
EXPO_PUBLIC_APPSFLYER_DEV_KEY=
EXPO_PUBLIC_APPSFLYER_APP_ID=

# --- Build-time only (read by app.config.ts, not compiled into the app) ---
# Set by the EAS build profile. Leave unset locally for a development build.
# APP_ENV=development
# Only to build against a different Expo project than the one in src/config/brand.ts.
# EAS_PROJECT_ID=
# Sentry's build step (source maps). Set as EAS secrets, with SENTRY_AUTH_TOKEN.
# SENTRY_ORG=
# SENTRY_PROJECT=

# --- Server secrets: NOT for this file ---
# These belong to the Edge Functions (`supabase secrets set ...`). They must
# never be given an EXPO_PUBLIC_ name or placed in the app. docs/services.md
# says which function uses which.
#   REVENUECAT_WEBHOOK_SECRET
#   REVENUECAT_SECRET_KEY
#   MUX_SIGNING_KEY_ID
#   MUX_SIGNING_PRIVATE_KEY
#   POSTHOG_KEY, POSTHOG_HOST   (optional: server-side subscription events)
